{
  "name": "siete-document-portal",
  "version": "1.0.1",
  "private": true,
  "description": "Windows desktop wrapper for the Siete Document Portal",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.siete.documentportal",
    "productName": "Siete Document Portal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "offline.html",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Siete-Document-Portal-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Siete Document Portal"
    }
  },
  "author": "Malissa Peterson",
  "repository": {
    "type": "git",
    "url": "https://github.com/Malamal32/SieteMaintenanceV2.git"
  }
}
